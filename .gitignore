__pycache__/
*.pyc

# runtime data — regenerated by server.py, not part of the site's source
clicks.json
bids.json
orders.json
subscribers.json

# machine-specific dev config (launch.json holds an absolute path)
.claude/

# ---- secrets: never commit these ----
# admin_auth.json holds the salted PBKDF2 hash of the admin password. The password itself is never
# written anywhere, but the hash is still a credential and is per-machine, so it stays untracked.
admin_auth.json
admin_token.txt
# supplier costs and landed cost — business data, and this repo is public
costs.json
# Stripe secret key and webhook signing secret. The signing secret is as sensitive as the API key:
# anyone holding it can forge a "payment succeeded" webhook and have the shop ship for free.
stripe_config.json
# the database: costs, orders and customer emails in one file
paidoff.db
paidoff.db-wal
paidoff.db-shm
*.key
*.pem
.env
.env.*
secrets.json

# admin-write backups — copies of the catalog, regenerated on every save
backups/
_cdp_*.py
_chrome_profile/
_chrome_tmp*/
_cleanup_test*
_inspect_db.py
_migrate_test/
_server_*.log
_shots*/
_test_checkout*
_verify_cleanup*
remote_test.txt
